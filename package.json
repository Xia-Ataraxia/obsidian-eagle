{
  "name": "obsidian-eagle-plugin",
  "version": "2.9.11",
  "type": "module",
  "description": "Upload images to Eagle and integrate with Obsidian notes.",
  "packageManager": "pnpm@10.28.2",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:build": "node scripts/esbuild.build.mjs",
    "build": "node scripts/esbuild.build.mjs production",
    "ci": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "verify": "pnpm run build && VAULT_NAME=${VAULT_NAME:-Test} obsidian vault=\"$VAULT_NAME\" plugin:reload id=eagle && node scripts/verify-plugin.mjs --vault \"$VAULT_NAME\" \"$@\"",
    "lint": "eslint . --ignore-pattern 'release/**'",
    "lint:fix": "eslint . --fix --ignore-pattern 'release/**'",
    "version": "node scripts/version.mjs",
    "postversion": "git push && git push --tags",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "eagle",
    "image-upload"
  ],
  "author": "Beomsu Koh",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "10.0.1",
    "@inquirer/prompts": "^8.7.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.0.5",
    "builtin-modules": "5.4.0",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "^17.6.0",
    "obsidian": "^1.14.4",
    "obsidian-utils": "^0.10.2",
    "prettier": "^3.9.10",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "scripts/**/*.{js,mjs}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.12.0",
      "diff": "^5.2.2",
      "fast-xml-parser": "^5.3.4",
      "form-data": "^4.0.4",
      "glob": "^10.5.0",
      "js-yaml": "^4.1.1",
      "lodash": "^4.17.23",
      "tar-fs": "^3.1.1",
      "tmp": "^0.2.4",
      "ws": "^8.17.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xia-Ataraxia/obsidian-eagle.git"
  },
  "bugs": {
    "url": "https://github.com/Xia-Ataraxia/obsidian-eagle/issues"
  },
  "homepage": "https://github.com/Xia-Ataraxia/obsidian-eagle#readme"
}
