{
  "name": "obsidian-eagle",
  "version": "2.9.11",
  "type": "module",
  "description": "Upload images to Eagle and integrate with Obsidian notes.",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "bun esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "bun run build && bun run typecheck && bun run lint && bun run test",
    "release": "curl -fsSL https://raw.githubusercontent.com/GoBeromsu/obsidian-boiler-template/main/scripts/release.ts | bun run -"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "eagle",
    "image-upload"
  ],
  "author": "Beomsu Koh",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "builtin-modules": "5.4.0",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "obsidian": "^1.14.4",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xia-Ataraxia/obsidian-eagle.git"
  },
  "bugs": {
    "url": "https://github.com/Xia-Ataraxia/obsidian-eagle/issues"
  },
  "homepage": "https://github.com/Xia-Ataraxia/obsidian-eagle#readme"
}
